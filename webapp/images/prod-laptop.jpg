<svg xmlns="http://www.w3.org/2000/svg" width="600" height="450" viewBox="0 0 600 450">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#020617;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="450" fill="url(#grad)" />
  <circle cx="300" cy="180" r="90" fill="rgba(255,255,255,0.08)" />
  <text x="300" y="205" font-size="72" text-anchor="middle" font-family="Segoe UI, Apple Color Emoji, sans-serif">💻</text>
  <text x="300" y="320" font-size="28" font-weight="bold" fill="#60a5fa" text-anchor="middle" font-family="Segoe UI, sans-serif">SphereBook Pro 16</text>
  <text x="300" y="360" font-size="16" fill="rgba(255,255,255,0.5)" text-anchor="middle" font-family="Segoe UI, sans-serif">ShopSphere Official Product</text>
</svg>
